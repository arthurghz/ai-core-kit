[6.66, "o", "\u001b[2mscan seed sources \u2192 open PRs into discovery/proposals/   (never merges)\u001b[0m\r\n"]
[6.84, "o", "\u001b[32m\u25cf\u001b[0m proposal  shadcn-theme-factory.yaml  \u001b[2mlicense: Apache-2.0  status: \u001b[0m\u001b[33mproposed\u001b[0m\r\n"]
