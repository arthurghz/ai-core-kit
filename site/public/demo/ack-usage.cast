[6.729998, "o", "\u001b[2m  ─────────────────────────────────────────\r\n\u001b[0m\r\n\u001b[1mNext steps:\r\n\u001b[0m  cd acme-app\r\n"]
[6.730077, "o", "  # review project.manifest.yaml (managed: is machine-owned)\r\n  # open the project in Claude Code and run \u001b[36m/ack-spec\u001b[0m to author the specs/\r\n  #   (deep, narrative interview -> filled PRD/ARCHITECTURE/DOMAIN/REQUIREMENTS/\r\n  #    ROADMAP/NON-GOALS + a refreshed CLAUDE.md). Specs lead; code follows.\r\n  # the contract gate is wired in .claude/settings.json (gate on an approved contract)\r\n  # run /ack-init to re-render the manifest-derived scaffold after stack edits\r\n  cd acme-app/docs && npm install && npm run dev   # product docs site\r\n\r\n"]
