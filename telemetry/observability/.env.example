# =============================================================================
# ai-core-kit cost-observability stack -- environment overrides (META layer)
# =============================================================================
# Copy to `.env` (same directory as docker-compose.yml) and edit. Every value
# has a built-in default in docker-compose.yml, so `.env` is optional.
#   cp .env.example .env
# =============================================================================

# --- Transcript source (mounted READ-ONLY into the exporter) -----------------
# Root that the exporter globs for **/*.jsonl. Leave this commented to use the
# compose default (~/.claude/projects, expanded from your shell). If you set it,
# use an ABSOLUTE path -- a .env file does NOT expand ${HOME} or ~.
# Point it at a different machine's collected transcripts to aggregate a fork's
# spend.
# ACK_PROJECT_DIR=/Users/you/.claude/projects

# --- Attribution -------------------------------------------------------------
# branch_prefix attribution: feature = the branch name after this prefix
# (e.g. feat/order-intake -> "order-intake").
ACK_BRANCH_PREFIX=feat/

# Optional: absolute path to a project.manifest.yaml the exporter reads
# telemetry.budgets[] from, to populate ack_budget_usd. Leave blank to disable
# the budget gauge. Must be bind-mounted into the exporter if set (see compose).
ACK_MANIFEST=

# --- Freshness ---------------------------------------------------------------
# Cache window (seconds) for a recompute. Within this window, repeat scrapes
# reuse the last aggregation instead of re-reading every transcript. Keep
# <= the Prometheus scrape_interval (30s). Lower = fresher, more disk I/O.
ACK_SCRAPE_TTL=30

# --- Host ports --------------------------------------------------------------
# Grafana is 3001 because 3000 is the docs site. Change only on conflicts.
ACK_GRAFANA_PORT=3001
ACK_PROMETHEUS_PORT=9090

# --- Grafana admin login (editing) -------------------------------------------
# Anonymous Viewer access needs no login; these are for editing dashboards.
# CHANGE THE PASSWORD before exposing this stack beyond localhost.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
